<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="springbootprojectDemo.mapper.EmpMapper">

    <update id="updateById">
        update employee
        <set>

            <if test="empNo!=null">
                emp_no = #{empNo},
            </if>

            <if test="name!=null">
                name = #{name},
            </if>

            <if test="department!=null">
                department = #{department},
            </if>

            <if test="phone!=null">
                phone = #{phone},
            </if>

            <if test="status!=null">
                status = #{status},
            </if>

            <if test="updateTime!=null">
                update_time = #{updateTime},
            </if>

        </set>
        where id = #{id}
    </update>


    <select id="page" resultType="springbootprojectDemo.pojo.Emp">
        select *
        from employee
        <where>
            <if test="name != null and name != '' ">
                name = #{name}
            </if>

            <if test="phone!=null">
                and phone = #{phone}
            </if>

            <if test="empNo!=null">
                and emp_no = #{empNo}
            </if>
        </where>

        limit #{start},#{pageSize}
    </select>

    <select id="count" resultType="long">
        select count(*)
        from employee
        <where>
            <if test="name != null and name != '' ">
                name = #{name}
            </if>

            <if test="phone!=null">
                and phone = #{phone}
            </if>

            <if test="empNo!=null">
                and emp_no = #{empNo}
            </if>
        </where>
    </select>

</mapper>